<%
  const fmt = (d) => d ? new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '-';
  const ilimitado = limite === Infinity;
  const pct = ilimitado ? 0 : Math.min(100, Math.round((empresasUsadas / Math.max(1, limite)) * 100));
  const temAssinatura = Boolean(conta.asaas && conta.asaas.subscriptionId);
  const precisaPagar = ['pendente', 'inadimplente'].includes(conta.status) || (!acesso.liberado && temAssinatura);
%>
<% (locals.avisos || []).forEach((a) => { %>
<div class="flash <%= a.tipo === 'importante' ? 'flash-erro' : 'flash-info' %>" style="white-space:pre-wrap">
  <strong><%= a.tipo === 'manutencao' ? 'Manutencao programada: ' : '' %><%= a.titulo %></strong><% if (a.texto) { %><br><%= a.texto %><% } %>
</div>
<% }) %>

<section class="cards">
  <div class="card stat">
    <span class="stat-label">Situacao</span>
    <span class="stat-value small-value"><span class="tag <%= rotuloStatus[1] %>"><%= rotuloStatus[0] %></span></span>
    <span class="muted small">
      <% if (conta.status === 'teste' || conta.status === 'pendente') { %>Teste ate <%= fmt(conta.testeAte) %>
      <% } else if (conta.pagoAte) { %>Pago ate <%= fmt(conta.pagoAte) %>
      <% } else if (conta.status === 'cortesia') { %>Sem cobranca<% } %>
    </span>
  </div>
  <div class="card stat">
    <span class="stat-label">Plano</span>
    <span class="stat-value small-value"><%= planoAtual ? planoAtual.nome : (conta.status === 'cortesia' ? 'Cortesia' : 'Teste gratis') %></span>
    <span class="muted small"><%= planoAtual ? brl(planoAtual.preco) + ' · ' + planoAtual.rotuloPeriodo.toLowerCase() : '' %></span>
  </div>
  <div class="card stat">
    <span class="stat-label">Clientes (CNPJ/CPF)</span>
    <span class="stat-value"><%= empresasUsadas %><span class="muted small"> / <%= ilimitado ? 'ilimitado' : limite %></span></span>
    <% if (!ilimitado) { %><div class="barra-uso" title="<%= pct %>%"><span style="width: <%= pct %>%" class="<%= pct >= 100 ? 'cheia' : '' %>"></span></div><% } %>
  </div>
  <div class="card stat">
    <span class="stat-label">Usuarios</span>
    <span class="stat-value"><%= usuarios %></span>
    <% const limU = conta.limiteUsuariosManual ?? (planoAtual && planoAtual.usuarios); %>
    <span class="muted small"><%= limU ? `equipe: ate ${limU} usuario(s)` : 'equipe ilimitada' %></span>
  </div>
</section>

<% if (precisaPagar) { %>
  <section class="card aviso-pagamento">
    <div>
      <h2><%= conta.status === 'pendente' ? 'Falta pouco: confirme o pagamento' : 'Ha uma fatura em aberto' %></h2>
      <p class="muted">Pague por Pix, boleto ou cartao. A liberacao e automatica assim que o pagamento for confirmado.</p>
    </div>
    <a class="btn btn-primary" href="/assinatura/pagar">Abrir fatura</a>
  </section>
<% } %>

<section class="card" id="planos">
  <div class="card-head">
    <h2>Pacotes e Planos disponíveis</h2>
    <% if (emailSuporte) { %>
      <a class="btn btn-sm btn-primary" href="mailto:<%= emailSuporte %>?subject=<%= encodeURIComponent('Plano do escritório ' + conta.nome) %>">Falar com a equipe</a>
    <% } %>
  </div>
  <p class="muted">A contratação, a troca de plano e o cancelamento são feitos com a nossa equipe.<%= planoAtual ? ` Seu plano atual é o ${planoAtual.nome} (${planoAtual.empresas == null ? 'clientes ilimitados' : `até ${planoAtual.empresas} clientes`}).` : '' %></p>

  <% const listaDisponivel = (planos || []).filter(p => p.ativo && p.publico); %>
  <% if (listaDisponivel.length) { %>
    <div class="cards" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); margin-top: 16px;">
      <% listaDisponivel.forEach(p => { 
          const eAtual = planoAtual && planoAtual.id === p.id;
      %>
        <div class="card" style="border: 2px solid <%= eAtual ? 'var(--primary, #3b82f6)' : (p.destaque ? '#f59e0b' : 'var(--border, #e5e7eb)') %>; position:relative; display:flex; flex-direction:column; justify-content:space-between; padding:16px;">
          <% if (eAtual) { %><span class="tag tag-ok" style="position:absolute; top:12px; right:12px;">Plano atual</span><% } else if (p.destaque) { %><span class="tag tag-warn" style="position:absolute; top:12px; right:12px;">Destaque</span><% } %>
          <div>
            <h3 style="margin-top:0"><%= p.nome %></h3>
            <div style="font-size:1.4rem; font-weight:700; margin:6px 0;">
              <%= brl(p.preco) %> <span style="font-size:0.85rem; font-weight:normal; color:var(--muted);"><%= p.rotuloPeriodo.toLowerCase() %></span>
            </div>
            <% if (p.descricao) { %><p class="small muted" style="margin-bottom:12px;"><%= p.descricao %></p><% } %>
            <ul style="list-style:none; padding:0; margin:10px 0; font-size:0.85rem; display:flex; flex-direction:column; gap:6px;">
              <li>✓ <strong><%= p.empresas == null ? 'Clientes/CNPJs ilimitados' : 'Até ' + p.empresas + ' clientes' %></strong></li>
              <li>✓ <%= p.usuarios == null ? 'Equipe ilimitada' : 'Até ' + p.usuarios + ' usuário(s)' %></li>
              <li>✓ <%= p.rotuloArmazenamento %></li>
              <li>✓ <%= p.funcionalidades.length %> funcionalidades</li>
            </ul>
          </div>
          <div style="margin-top:14px;">
            <% if (eAtual) { %>
              <button class="btn btn-sm btn-ghost" disabled style="width:100%">Seu plano atual</button>
            <% } else if (emailSuporte) { %>
              <a class="btn btn-sm btn-primary" href="mailto:<%= emailSuporte %>?subject=<%= encodeURIComponent('Quero contratar o pacote ' + p.nome + ' - Escritório ' + conta.nome) %>" style="width:100%; text-align:center; display:block;">Quero este plano</a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (locals.ehAdmin) { %>
<section class="card" id="dados">
  <div class="card-head"><h2>Dados do escritorio</h2></div>
  <form method="post" action="/assinatura/dados" class="form">
    <div class="form-row">
      <label>Nome do escritorio
        <input type="text" name="nome" required value="<%= conta.nome %>" />
      </label>
      <label>CNPJ/CPF de cobranca
        <input type="text" name="documento" inputmode="numeric" value="<%= conta.documento || '' %>" <%= temAssinatura ? 'readonly' : '' %> />
      </label>
    </div>
    <div class="form-row">
      <label>E-mail de cobranca
        <input type="email" name="emailCobranca" value="<%= conta.emailCobranca || '' %>" />
      </label>
      <label>Celular
        <input type="tel" name="telefone" value="<%= conta.telefone || '' %>" />
      </label>
    </div>
    <label>Quem recebe os alertas (certificado vencendo, notas novas, prazos). Separe por virgula; vazio = administradores do escritorio.
      <input type="text" name="alertasPara" value="<%= (conta.config && conta.config.alertasPara || []).join(', ') %>" />
    </label>
    <div class="form-actions"><button class="btn btn-primary">Salvar</button></div>
  </form>
</section>
<% } %>
