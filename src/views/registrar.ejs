<p class="auth-sub">Teste gratis por <strong><%= teste.dias %> dias</strong>, sem cartao. Ate <%= teste.empresas %> empresa(s) no teste.</p>
<form method="post" action="/registrar" class="form" autocomplete="on">
  <input type="hidden" name="plano" value="<%= plano %>" />
  <div class="campo-oculto" aria-hidden="true"><label>Site <input type="text" name="site" tabindex="-1" autocomplete="off" /></label></div>
  <label>Seu nome
    <input type="text" name="nome" required autofocus autocomplete="name" value="<%= form.nome || '' %>" />
  </label>
  <label>E-mail
    <input type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>" />
  </label>
  <label>Empresa ou escritorio
    <input type="text" name="conta" required placeholder="Ex.: Contabilidade Silva" value="<%= form.conta || '' %>" />
  </label>
  <div class="form-row">
    <label>CNPJ ou CPF (para cobranca)
      <input type="text" name="documento" required inputmode="numeric" value="<%= form.documento || '' %>" />
    </label>
    <label>Celular (opcional)
      <input type="tel" name="telefone" autocomplete="tel" value="<%= form.telefone || '' %>" />
    </label>
  </div>
  <div class="form-row">
    <label>Senha (min. 8)
      <input type="password" name="senha" required minlength="8" autocomplete="new-password" />
    </label>
    <label>Confirmar senha
      <input type="password" name="confirmar" required minlength="8" autocomplete="new-password" />
    </label>
  </div>
  <label class="check-termos">
    <input type="checkbox" name="termos" required />
    <span>Li e aceito os <a href="/termos" target="_blank">termos de uso</a> e a <a href="/privacidade" target="_blank">politica de privacidade</a>.</span>
  </label>
  <button type="submit" class="btn btn-primary btn-block">Criar conta gratis</button>
</form>
<p class="auth-foot">Ja tem conta? <a href="/login">Entrar</a></p>
