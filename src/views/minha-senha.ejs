<div class="card card-form">
  <form method="post" action="/minha-senha" class="form">
    <label>Senha atual <input type="password" name="atual" required autocomplete="current-password" /></label>
    <div class="form-row">
      <label>Nova senha (min. 8 caracteres) <input type="password" name="nova" required minlength="8" autocomplete="new-password" /></label>
      <label>Confirmar nova senha <input type="password" name="confirmar" required minlength="8" autocomplete="new-password" /></label>
    </div>
    <div class="form-actions"><button class="btn btn-primary">Salvar</button></div>
  </form>
</div>
