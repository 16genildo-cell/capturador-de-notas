<div class="card card-form">
  <form method="post" action="<%= empresa._id ? '/empresas/' + empresa._id : '/empresas' %>" class="form">
    <div class="form-row">
      <label>Razao social / Nome *
        <input type="text" name="razaoSocial" value="<%= empresa.razaoSocial || '' %>" required />
      </label>
      <label>Nome fantasia
        <input type="text" name="nomeFantasia" value="<%= empresa.nomeFantasia || '' %>" />
      </label>
    </div>

    <div class="form-row">
      <label>CNPJ ou CPF *
        <input type="text" name="cnpj" value="<%= empresa.cnpj || '' %>" required placeholder="CNPJ da empresa ou CPF da pessoa fisica" />
      </label>
      <label>UF *
        <input type="text" name="uf" value="<%= empresa.uf || '' %>" maxlength="2" required placeholder="SP" />
      </label>
    </div>

    <div class="form-row">
      <label>Inscricao estadual
        <input type="text" name="inscricaoEstadual" value="<%= empresa.inscricaoEstadual || '' %>" />
      </label>
      <label>Inscricao municipal
        <input type="text" name="inscricaoMunicipal" value="<%= empresa.inscricaoMunicipal || '' %>" />
      </label>
    </div>

    <div class="form-row">
      <label>Codigo IBGE do municipio
        <input type="text" name="municipioCodigo" value="<%= empresa.municipioCodigo || '' %>" />
      </label>
      <label>Municipio
        <input type="text" name="municipioNome" value="<%= empresa.municipioNome || '' %>" />
      </label>
    </div>

    <div class="form-row">
      <label>Certificado digital (e-CNPJ ou e-CPF)
        <select name="certificado">
          <option value="">— selecione —</option>
          <% certificados.forEach((c) => { %>
            <option value="<%= c._id %>" <%= String(empresa.certificado) === String(c._id) ? 'selected' : '' %>>
              <%= c.apelido %><%= c.cnpjCpf ? ' (' + c.cnpjCpf + ')' : '' %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>Provedor NFS-e
        <select name="nfseProvedor">
          <option value="nacional" <%= (empresa.nfseMunicipal && empresa.nfseMunicipal.provedor === 'nacional') ? 'selected' : '' %>>Padrao Nacional</option>
          <option value="exemplo" <%= (empresa.nfseMunicipal && empresa.nfseMunicipal.provedor === 'exemplo') ? 'selected' : '' %>>Exemplo (homologacao)</option>
        </select>
      </label>
    </div>

    <% const cap = Object.assign({ nfe: true, nfse: true, cte: true }, empresa.captura || {}); %>
    <fieldset class="checks">
      <legend>O que capturar</legend>
      <label class="check"><input type="checkbox" name="capturaNfe" <%= cap.nfe ? 'checked' : '' %> /> NF-e / NFC-e (produtos)</label>
      <label class="check"><input type="checkbox" name="capturaNfse" <%= cap.nfse ? 'checked' : '' %> /> NFS-e (servicos)</label>
      <label class="check"><input type="checkbox" name="capturaCte" <%= cap.cte ? 'checked' : '' %> /> CT-e (transporte)</label>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Salvar</button>
      <a href="<%= locals.base || '/empresas' %>" class="btn btn-ghost">Cancelar</a>
    </div>
  </form>
</div>
