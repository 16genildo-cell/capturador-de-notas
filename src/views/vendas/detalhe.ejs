<%
  const e = emissao;
  const brl = (n) => Number(n || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dataHora = (d) => (d ? new Date(d).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : '-');
  const tag = { autorizada: 'tag-ok', rejeitada: 'tag-err', denegada: 'tag-err', sem_resposta: 'tag-warn', cancelada: 'tag-err', contingencia: 'tag-warn' }[e.status];
  const txt = { autorizada: 'Autorizada', rejeitada: 'Rejeitada', denegada: 'Denegada', sem_resposta: 'Sem resposta da SEFAZ', cancelada: 'Cancelada', contingencia: 'Contingência Offline' }[e.status];
  const valida = e.status === 'autorizada' || e.status === 'cancelada' || e.status === 'contingencia';
  const nomeEvento = { 110111: 'Cancelamento', 110110: 'Carta de correcao' };
  const msgWhats = `*Comprovante Fiscal - ${nome} nº ${e.numero || ''}*\n` +
    `Emitente: ${e.empresa?.razaoSocial || ''}\n` +
    `Valor: R$ ${brl(e.valor)}\n` +
    `Chave: ${e.chave || ''}\n` +
    `Protocolo: ${e.protocolo || '-'}\n` +
    `Consulte: https://www.nfe.fazenda.gov.br/portal/consultaRecaptcha.aspx`;
  const linkWhats = `https://api.whatsapp.com/send?text=${encodeURIComponent(msgWhats)}`;
%>
<div class="page-actions row-actions">
  <a href="<%= base %>/vendas<%= locals.empresaAtual ? '' : '?empresa=' + (e.empresa && e.empresa._id) %>" class="btn btn-ghost">Voltar</a>
  <% if (valida) { %>
    <a href="<%= base %>/vendas/<%= e._id %>/pdf" target="_blank" class="btn btn-primary"><%= e.modelo === '65' ? 'Imprimir cupom (DANFE NFC-e)' : 'Ver DANFE' %></a>
    <% if (e.modelo === '65') { %>
      <a href="<%= base %>/vendas/<%= e._id %>/cupom-termico" target="_blank" class="btn btn-secondary" title="Imprimir em impressora térmica 80mm">Cupom Térmico (80mm)</a>
      <a href="<%= base %>/vendas/<%= e._id %>/escpos" class="btn btn-ghost" title="Arquivo de comandos ESC/POS para impressora serial/USB">ESC/POS (.bin)</a>
    <% } %>
    <a href="<%= base %>/vendas/<%= e._id %>/pdf?baixar=1" class="btn">Baixar PDF</a>
    <a href="<%= linkWhats %>" target="_blank" rel="noopener noreferrer" class="btn" style="background:#16a34a;color:#fff;border-color:#16a34a;" title="Enviar cupom por WhatsApp">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px;"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.188 8.188 0 0 1-5.82 2.41c-1.42 0-2.82-.37-4.06-1.08l-.29-.17-3.03.79.81-2.95-.19-.31a8.188 8.188 0 0 1-1.25-4.51c0-4.54 3.7-8.24 8.24-8.24m-3.57 3.52c-.2 0-.43.08-.65.33-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.1-.23-.17-.48-.3s-1.48-.73-1.71-.81c-.23-.09-.4-.13-.57.13-.17.25-.66.82-.81.99-.15.17-.3.19-.55.07-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.49-1.4-1.74-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.43.12-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.2-.5-.41-.43-.57-.44h-.49z"/></svg>
      WhatsApp
    </a>
    <button type="button" class="btn" onclick="document.getElementById('modal-email').style.display='flex'" title="Enviar cupom por E-mail">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
      E-mail
    </button>
  <% } %>
  <a href="<%= base %>/vendas/<%= e._id %>/xml" class="btn">XML</a>
  <% if (e.nota) { %><a href="<%= base %>/notas/<%= e.nota %>" class="btn">Ver nas notas fiscais</a><% } %>
  <a href="<%= base %>/vendas?de=<%= e._id %>" class="btn">Emitir outra igual</a>
</div>

<section class="card">
  <div class="card-head">
    <h2><%= nome %> n <%= e.numero %> · serie <%= e.serie %></h2>
    <span><span class="tag <%= tag %>"><%= txt %></span><% if (e.ambiente !== 'producao') { %> <span class="tag tag-warn" title="Ambiente de testes: sem valor fiscal">homologacao</span><% } %></span>
  </div>
  <% if (e.status === 'rejeitada' || e.status === 'denegada') { %>
    <div class="flash flash-erro"><strong><%= e.cStat %> - <%= e.xMotivo %></strong>
      <% if (e.status === 'rejeitada') { %><br><span class="small">A nota nao foi emitida e o numero continua livre. Corrija o problema (cadastro do produto, cliente ou configuracao) e emita de novo.</span><% } %></div>
  <% } %>
  <% if (e.status === 'contingencia') { %>
    <div class="flash flash-warn">
      <strong>⚠️ Cupom emitido em Contingência Offline:</strong> Esta venda foi impressa para o consumidor, mas ainda está pendente de homologação na SEFAZ (prazo legal de até 24 horas).
      <form method="post" action="<%= base %>/vendas/<%= e._id %>/reconsultar" class="inline" style="margin-left: 8px;">
        <button class="btn btn-sm btn-primary">Transmitir para a SEFAZ agora</button>
      </form>
    </div>
  <% } %>
  <% if (e.status === 'sem_resposta') { %>
    <div class="flash flash-info">A SEFAZ nao respondeu a tempo. A nota pode ter sido autorizada: consulte antes de emitir de novo.
      <form method="post" action="<%= base %>/vendas/<%= e._id %>/reconsultar" class="inline"><button class="btn btn-sm">Consultar na SEFAZ</button></form>
      <% if (e.xMotivo) { %><div class="small muted"><%= e.xMotivo %></div><% } %>
    </div>
  <% } %>
  <ul class="kv">
    <li><span class="muted">Emitente</span><span><%= e.empresa ? e.empresa.razaoSocial : '-' %></span></li>
    <li><span class="muted">Cliente</span><span><%= e.destNome || (e.modelo === '65' ? 'Consumidor nao identificado' : '-') %><%= e.destDocumento ? ' · ' + e.destDocumento : '' %></span></li>
    <li><span class="muted">Valor</span><span>R$ <%= brl(e.valor) %> · <%= e.qtdItens %> item(ns)</span></li>
    <li><span class="muted">Chave de acesso</span><span class="small mono"><%= (e.chave || '').replace(/(\d{4})(?=\d)/g, '$1 ') %></span></li>
    <li><span class="muted">Protocolo</span><span><%= e.protocolo || '-' %><%= e.dataAutorizacao ? ' · ' + dataHora(e.dataAutorizacao) : '' %></span></li>
    <li><span class="muted">Emitida em</span><span><%= dataHora(e.createdAt) %></span></li>
  </ul>
</section>

<section class="card">
  <div class="card-head"><h2>Auditoria & Rastreabilidade</h2></div>
  <ul class="kv">
    <li><span class="muted">Emitido por (Usuário)</span><span><strong><%= e.usuario?.nome ? `${e.usuario.nome} (${e.usuario.email})` : (e.usuario?.email || 'Sistema / API') %></strong></span></li>
    <li><span class="muted">Perfil do emissor</span><span><%= e.usuario?.role ? (e.usuario.role === 'admin' ? 'Administrador' : e.usuario.role) : 'Administrador' %></span></li>
    <li><span class="muted">Ambiente de autorização</span><span><%= e.ambiente === 'producao' ? 'Produção (SEFAZ)' : 'Homologação (Ambiente de testes SEFAZ)' %></span></li>
    <li><span class="muted">Data/Hora da autorização SEFAZ</span><span><%= e.dataAutorizacao ? dataHora(e.dataAutorizacao) : '-' %></span></li>
    <li><span class="muted">Protocolo oficial</span><span><%= e.protocolo || '-' %></span></li>
    <li><span class="muted">Retorno SEFAZ</span><span><%= e.cStat ? `${e.cStat} - ${e.xMotivo}` : '-' %></span></li>
  </ul>
</section>

<% if ((e.eventos || []).length) { %>
<section class="card">
  <div class="card-head"><h2>Eventos</h2></div>
  <ul class="log-list">
    <% e.eventos.forEach((ev, i) => { const ok = ['135', '136', '155'].includes(ev.cStat); %>
      <li>
        <span class="tag <%= ok ? 'tag-ok' : 'tag-err' %>"><%= ok ? 'registrado' : 'recusado' %></span>
        <strong><%= nomeEvento[ev.tipo] || ev.tipo %><%= ev.tipo === '110110' ? ' n ' + ev.seq : '' %></strong>
        <span class="log-msg"><%= ev.texto %> · <%= ev.cStat %> - <%= ev.xMotivo %> · <%= dataHora(ev.data) %></span>
        <a href="<%= base %>/vendas/<%= e._id %>/xml?evento=<%= i %>" class="link small">XML</a>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (e.status === 'autorizada' && locals.ehAdmin) { %>
<div class="grid-2">
  <section class="card">
    <div class="card-head"><h2>Cancelar <%= nome %></h2></div>
    <p class="muted small">Prazo: NF-e ate 24 horas apos a autorizacao; NFC-e em poucos minutos (em MG, confira o prazo atual da SEFAZ). Depois disso a SEFAZ recusa.</p>
    <form method="post" action="<%= base %>/vendas/<%= e._id %>/cancelar" class="form" onsubmit="return confirm('Cancelar esta nota na SEFAZ? Nao da para desfazer.')">
      <label>Justificativa (15 a 255 caracteres) <input type="text" name="justificativa" minlength="15" maxlength="255" required /></label>
      <button class="btn btn-danger">Cancelar nota</button>
    </form>
  </section>
  <% if (e.modelo === '55') { %>
  <section class="card">
    <div class="card-head"><h2>Carta de correcao</h2></div>
    <p class="muted small">Nao pode alterar valores, impostos, quantidades, remetente/destinatario nem a data. Cada nova carta substitui a anterior.</p>
    <form method="post" action="<%= base %>/vendas/<%= e._id %>/cce" class="form">
      <label>Correcao (15 a 1000 caracteres) <textarea name="correcao" rows="3" minlength="15" maxlength="1000" required></textarea></label>
      <button class="btn">Enviar carta de correcao</button>
    </form>
  </section>
  <% } %>
</div>
<% } %>

<% if (valida) { %>
<div id="modal-email" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.6);z-index:9999;align-items:center;justify-content:center;padding:16px;">
  <div class="card" style="max-width:460px;width:100%;margin:0;background:var(--surface,#fff);box-shadow:0 20px 25px -5px rgba(0,0,0,0.3);border-radius:12px;">
    <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;border-bottom:1px solid var(--border,#e2e8f0);">
      <h2 style="margin:0;font-size:1.15rem;">Enviar comprovante por e-mail</h2>
      <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-email').style.display='none'" style="font-size:1.1rem;padding:4px 8px;">✕</button>
    </div>
    <form method="post" action="<%= base %>/vendas/<%= e._id %>/enviar-email" class="form" style="margin-top:14px;">
      <label>E-mail do cliente / destinatário:
        <input type="email" name="email" value="<%= e.dados?.dest?.email || '' %>" required placeholder="cliente@exemplo.com" autofocus />
      </label>
      <p class="muted small" style="margin-top:8px;line-height:1.4;">O e-mail será enviado com o PDF do documento fiscal (DANFE) e o XML oficial da SEFAZ em anexo.</p>
      <div class="row-actions" style="margin-top:16px;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-email').style.display='none'">Cancelar</button>
        <button type="submit" class="btn btn-primary">Enviar por E-mail</button>
      </div>
    </form>
  </div>
</div>
<% } %>
