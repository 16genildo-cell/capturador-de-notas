{
  "name": "captura-total",
  "version": "1.0.0",
  "description": "Sistema de captura automatica de notas fiscais eletronicas (NF-e, NFC-e e NFS-e) a partir dos web services oficiais da SEFAZ e do padrao nacional da NFS-e, usando o certificado digital A1 da empresa.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "diagnostico": "node src/scripts/diagnostico-planos.js",
    "admin:senha": "node src/scripts/redefinir-admin.js",
    "backup": "node src/scripts/backup.js",
    "restaurar": "node src/scripts/restaurar.js",
    "servico:instalar": "node src/scripts/servico-windows.js instalar",
    "servico:remover": "node src/scripts/servico-windows.js remover",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nfe",
    "nfse",
    "sefaz",
    "nota-fiscal",
    "certificado-digital",
    "fiscal"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "fast-xml-parser": "^5.11.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.0.0"
  }
}
